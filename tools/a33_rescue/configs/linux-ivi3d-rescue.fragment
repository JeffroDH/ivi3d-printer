# IVI3D rescue kernel: applied on top of arch/arm/configs/sunxi_defconfig (Linux 6.18.62).
CONFIG_LOCALVERSION="-ivi3d-rescue"
# CONFIG_LOCALVERSION_AUTO is not set
# Storage, partitions, filesystems needed by the rescue scripts
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=16
CONFIG_BLK_DEV_LOOP=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_TMPFS=y
# USB device side (OTG) only: optional read-only mass-storage gadget via configfs
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_USB_MUSB_GADGET=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_CONFIGFS_FS=y
# Do not talk to the USB host side (GL850G hub -> CH340 -> STM32)
# CONFIG_USB_SERIAL is not set
# CONFIG_USB_STORAGE is not set
# No display, sound, GPU, Wi-Fi: rescue is console-only on the debug UART
# CONFIG_DRM is not set
# CONFIG_SOUND is not set
# CONFIG_SND is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_CFG80211 is not set
# CONFIG_NET is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# Console
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_MAGIC_SYSRQ=y
# CONFIG_USB_EHCI_HCD is not set
# CONFIG_USB_OHCI_HCD is not set
CONFIG_DEBUG_FS=y
